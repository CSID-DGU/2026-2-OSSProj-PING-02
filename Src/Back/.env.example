# 서버
PORT=5010
NODE_ENV=development

# HTTPS 도메인 (docker compose --profile app 의 caddy 가 인증서를 받아 오는 주소). 운영에서만 설정한다.
# 예: malssiat.koreacentral.cloudapp.azure.com
DOMAIN=localhost

# PostgreSQL (docker-compose.yml 기준)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=malssiat
DB_PASSWORD=malssiat
DB_NAME=malssiat
# 개발 환경에서만 true. 운영에서는 마이그레이션으로 스키마를 관리한다.
DB_SYNCHRONIZE=true
# 마이그레이션을 서버 시작 때 자동 적용 (운영에서 true 권장, DB_SYNCHRONIZE는 false)
DB_MIGRATIONS_RUN=false

# 앞단 리버스 프록시(Caddy 등) 개수. 서버 앞에 프록시를 두면 1 로 설정한다(IP 기준 요청 제한이 실제 사용자 IP로 동작).
# 프록시 없이 직접 노출할 때는 0 으로 둔다(X-Forwarded-For 헤더를 믿지 않음).
TRUST_PROXY=0

# JWT (accessToken). 운영에서는 32자 이상 랜덤 값으로 교체한다.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30

# 모델 파일 CDN (1.5.2). 현재는 서명 없이 "{base}/{storage_key}" 로 만든다.
MODEL_CDN_BASE_URL=https://cdn.example.com/models
MODEL_URL_TTL_MINUTES=15

# 메일 발송 (아이디 찾기, 비밀번호 재설정 코드). 실제 SMTP 서버 정보를 넣는다. 비워 두면 찾기 메일만 가지 않는다(가입·로그인은 동작).
MAIL_HOST=
MAIL_PORT=587
# 465 포트를 쓰면 true
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=말씨앗 <no-reply@example.com>

# AI 답장 통로 (OpenRouter). 키와 모델이 비어 있으면 /v1/ai/reply 만 503 으로 응답한다.
# 서버는 메시지를 저장하지 않는다. 키는 운영 서버 .env 에만 둔다.
OPENROUTER_API_KEY=
# 사용할 모델 ID (예: OpenRouter 모델 페이지의 id). ZDR 엔드포인트가 있는 모델이어야 한다.
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=400
# 앱이 보내는 메시지 최대 글자 수
AI_MAX_INPUT_CHARS=1000
# 사용자별 호출 한도 (서버 메모리에서만 센다. 재시작하면 초기화)
AI_RATE_PER_MINUTE=10
AI_RATE_PER_DAY=300

# 보조(테스트용) AI 통로: Claude API. 주 통로는 위의 OpenRouter 다.
# AI_PROVIDER 를 비우거나 openrouter 로 두면 OpenRouter 를 쓰고, anthropic 이면 Claude API 를 쓴다.
# 그 밖의 값(오타 등)이면 어느 쪽으로도 보내지 않고 /v1/ai/reply 만 503 으로 응답한다.
# Claude 통로는 OpenRouter 처럼 요청마다 데이터 미보관(ZDR)을 강제하지 않는다. 실제 사용자에게 켜기 전에 약관을 고쳐야 한다.
AI_PROVIDER=
# Claude Console(platform.claude.com) → API Keys 에서 발급. 운영 서버 .env 에만 두고, Console 에서 사용 한도를 건다.
ANTHROPIC_API_KEY=
# 모델 ID (예: claude-sonnet-5-5, claude-haiku-5-5, claude-opus-5-5). 키나 모델이 비어 있으면 AI 요청만 503.
ANTHROPIC_MODEL=
# 테스트에서 가짜 서버로 보낼 때만 쓴다. 비우면 Claude API 기본 주소.
ANTHROPIC_BASE_URL=
# 생각(thinking) 토큰도 포함되므로 OpenRouter(400)보다 크게 둔다.
ANTHROPIC_MAX_OUTPUT_TOKENS=2048
# 생각 깊이: low | medium | high | xhigh | max (잘못된 값이면 low)
ANTHROPIC_EFFORT=low
