# 서버
PORT=5010
NODE_ENV=development

# HTTPS 도메인 (docker compose --profile app 의 caddy 가 인증서를 받아 오는 주소). 운영에서만 설정한다.
# 예: malssiat.koreacentral.cloudapp.azure.com
DOMAIN=localhost

# PostgreSQL (docker-compose.yml 기준)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=malssiat
DB_PASSWORD=malssiat
DB_NAME=malssiat
# 개발 환경에서만 true. 운영에서는 마이그레이션으로 스키마를 관리한다.
DB_SYNCHRONIZE=true
# 마이그레이션을 서버 시작 때 자동 적용 (운영에서 true 권장, DB_SYNCHRONIZE는 false)
DB_MIGRATIONS_RUN=false

# 앞단 리버스 프록시(Caddy 등) 개수. 서버 앞에 프록시를 두면 1 로 설정한다(IP 기준 요청 제한이 실제 사용자 IP로 동작).
# 프록시 없이 직접 노출할 때는 0 으로 둔다(X-Forwarded-For 헤더를 믿지 않음).
TRUST_PROXY=0

# JWT (accessToken). 운영에서는 32자 이상 랜덤 값으로 교체한다.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30

# 모델 파일 CDN (1.5.2). 현재는 서명 없이 "{base}/{storage_key}" 로 만든다.
MODEL_CDN_BASE_URL=https://cdn.example.com/models
MODEL_URL_TTL_MINUTES=15

# 메일 발송 (이메일 인증 코드). 실제 SMTP 서버 정보를 넣는다. 비워 두면 가입이 503 으로 실패한다.
MAIL_HOST=
MAIL_PORT=587
# 465 포트를 쓰면 true
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=말씨앗 <no-reply@example.com>
